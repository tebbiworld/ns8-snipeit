# Defaults of a new instance; configure-module applies the real settings.

from pathlib import Path

import agent
import timezones

# The node time zone is the default time zone of Snipe-IT, if Snipe-IT knows
# it (a legacy name like US/Eastern is not in its list)
try:
    timezone = str(Path("/etc/localtime").resolve().relative_to(Path("/usr/share/zoneinfo")))
except ValueError:
    timezone = timezones.DEFAULT
if not timezones.is_valid(timezone):
    timezone = timezones.DEFAULT

agent.set_env("SNIPEIT_TIMEZONE", timezone)
agent.set_env("SNIPEIT_INSTALLED", "0")
agent.set_env("MAIL_FROM", "")
agent.set_env("LDAP_ENABLED", "false")
agent.set_env("LDAP_FIRST_NAME", "login")
