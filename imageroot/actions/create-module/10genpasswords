# Generate the secrets of a new instance into state/passwords.env (mode
# 0600): the Laravel application key and the MariaDB passwords. They never go
# to state/environment, which NS8 mirrors to Redis in plain text. ensure()
# keeps existing values, e.g. the ones restored from a backup.

import base64
import secrets

import modsecrets

db_password = secrets.token_urlsafe(24)
modsecrets.ensure({
    # Laravel encrypts sessions, the LDAP bind password and encrypted custom
    # fields with this key: it must stay the same for the life of the data
    "APP_KEY": "base64:" + base64.b64encode(secrets.token_bytes(32)).decode(),
    "MARIADB_ROOT_PASSWORD": secrets.token_urlsafe(24),
    # the same password under the names of the database and the app container
    "MARIADB_PASSWORD": db_password,
    "DB_PASSWORD": db_password,
})
