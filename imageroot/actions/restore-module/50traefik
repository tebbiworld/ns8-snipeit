# Configure the restored instance (Traefik route, directory login, start)
# from the settings copied by 06copyenv. The environment is used instead of
# request['environment'] because this step is linked into clone-module too,
# whose request has no environment.

import os
import sys

import agent
import agent.tasks
import ldapsettings

host = os.environ.get("TRAEFIK_HOST", "")
if not host or os.environ.get("SNIPEIT_INSTALLED") != "1":
    print(agent.SD_NOTICE + "the original instance was not configured: configure the module from the UI", file=sys.stderr)
    sys.exit(0)

request = {
    "host": host,
    "lets_encrypt": os.environ.get("TRAEFIK_LETS_ENCRYPT", "True") == "True",
    "http2https": os.environ.get("TRAEFIK_HTTP2HTTPS", "True") == "True",
    "mail_from": os.environ.get("MAIL_FROM", ""),
    "ldap_enabled": os.environ.get("LDAP_ENABLED") == "true",
}
if request["ldap_enabled"]:
    # blank bind password: the restored state/passwords.env is kept
    request.update(ldapsettings.restore_data())
configure_retval = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data=request)
agent.assert_exp(configure_retval["exit_code"] == 0, "the configure-module subtask failed")
