{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Snipe-IT settings",
    "$id": "http://schema.nethserver.org/snipeit/get-configuration-output.json",
    "description": "Snipe-IT settings",
    "examples": [
        {
            "host": "assets.example.org",
            "http2https": true,
            "lets_encrypt": true,
            "installed": true,
            "mail_from": "",
            "ldap_enabled": false,
            "first_name_attribute": "login"
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name of Snipe-IT; empty before the first configuration"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "installed": {
            "type": "boolean",
            "description": "The first super user exists (the web installer is closed)"
        },
        "mail_from": {
            "type": "string"
        },
        "first_name_attribute": {
            "type": "string",
            "enum": [
                "login",
                "givenname"
            ]
        },
        "ldap_enabled": {
            "type": "boolean",
            "title": "Login with a user domain or LDAP server"
        },
        "ldap_active": {
            "type": "boolean",
            "description": "Snipe-IT uses the directory login (false while it could not be prepared)"
        },
        "ldap_source": {
            "type": "string",
            "enum": [
                "domain",
                "custom"
            ]
        },
        "ldap_domain": {
            "type": "string",
            "maxLength": 253
        },
        "ldap_group": {
            "type": "string",
            "description": "Only members of this group may log in (Active Directory)"
        },
        "ldap_url": {
            "type": "string",
            "maxLength": 512
        },
        "ldap_start_tls": {
            "type": "boolean"
        },
        "ldap_tls_verify": {
            "type": "boolean"
        },
        "ldap_schema": {
            "type": "string",
            "enum": [
                "ad",
                "rfc2307"
            ]
        },
        "ldap_base_dn": {
            "type": "string",
            "maxLength": 512
        },
        "ldap_bind_dn": {
            "type": "string",
            "maxLength": 512
        },
        "ldap_user_attribute": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9-]*$"
        },
        "ldap_bind_password_set": {
            "type": "boolean"
        },
        "user_domains": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
