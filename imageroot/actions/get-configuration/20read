# Return the settings configure-module accepts. The application key, the
# database passwords and the LDAP bind password are kept in
# state/passwords.env and never returned.

import json
import os
import sys

import ldapsettings
import timezones

config = {
    "host": os.getenv("TRAEFIK_HOST", ""),
    "lets_encrypt": os.getenv("TRAEFIK_LETS_ENCRYPT") == "True",
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS", "True") == "True",
    # false also when the super user disappeared: the UI asks for a new one
    "installed": os.getenv("SNIPEIT_INSTALLED") == "1" and os.getenv("SNIPEIT_SETUP_MISSING") != "1",
    "mail_from": os.getenv("MAIL_FROM", ""),
    "timezone": os.getenv("SNIPEIT_TIMEZONE") or timezones.DEFAULT,
    "timezones": timezones.available(),
    # times are stored: a time zone change needs timezone_change_confirmed
    "stored_times": os.getenv("SNIPEIT_INSTALLED") == "1",
    # instances of 1.0 have no LDAP_FIRST_NAME: they use the login name
    "first_name_attribute": os.getenv("LDAP_FIRST_NAME") or "login",
    "ldap_enabled": os.getenv("LDAP_ENABLED") == "true",
    # Snipe-IT uses the directory login: false while it is on but could not
    # be prepared (see the journal of snipeit-app)
    "ldap_active": os.getenv("LDAP_ACTIVE") == "true",
}
config.update(ldapsettings.configuration())
json.dump(config, fp=sys.stdout)
