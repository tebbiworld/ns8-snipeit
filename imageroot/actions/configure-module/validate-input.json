{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure Snipe-IT",
    "$id": "http://schema.nethserver.org/snipeit/configure-module-input.json",
    "description": "Configure Snipe-IT",
    "examples": [
        {
            "host": "assets.example.org",
            "http2https": true,
            "lets_encrypt": true,
            "admin_user": "admin",
            "admin_password": "a long secret password",
            "admin_email": "admin@example.org",
            "site_name": "Example IT"
        },
        {
            "host": "assets.example.org",
            "http2https": true,
            "lets_encrypt": true,
            "mail_from": "assets@example.org",
            "ldap_enabled": true,
            "ldap_source": "domain",
            "ldap_domain": "ad.example.org",
            "ldap_group": "snipeit-users"
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name of Snipe-IT, like 'assets.example.org'",
            "format": "hostname",
            "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "admin_user": {
            "type": "string",
            "maxLength": 100,
            "description": "First Snipe-IT super user, created by the first configuration only",
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "admin_password": {
            "type": "string",
            "maxLength": 200,
            "description": "Password of the super user: first configuration only, at least 12 characters, not stored by the module",
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "admin_email": {
            "type": "string",
            "maxLength": 254,
            "description": "Mail address of the super user, also the alert address",
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "site_name": {
            "type": "string",
            "maxLength": 100,
            "description": "Name of the installation shown by Snipe-IT (first configuration only)",
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "mail_from": {
            "type": "string",
            "maxLength": 254,
            "description": "Sender address of Snipe-IT mails; empty: snipeit@<host>",
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "ldap_enabled": {
            "type": "boolean",
            "title": "Login with a user domain or LDAP server"
        },
        "ldap_source": {
            "type": "string",
            "enum": [
                "domain",
                "custom"
            ]
        },
        "ldap_domain": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "ldap_group": {
            "type": "string",
            "maxLength": 512,
            "description": "Only members of this group may log in (Active Directory)",
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "ldap_url": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "ldap_start_tls": {
            "type": "boolean"
        },
        "ldap_tls_verify": {
            "type": "boolean"
        },
        "ldap_schema": {
            "type": "string",
            "enum": [
                "ad",
                "rfc2307"
            ]
        },
        "ldap_base_dn": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "ldap_bind_dn": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "ldap_bind_password": {
            "type": "string",
            "maxLength": 512,
            "description": "Write only; empty keeps the stored password",
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "ldap_user_attribute": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9-]*$"
        }
    }
}
