# The snipeit pod: MariaDB and the Snipe-IT web server share its network.
# slirp4netns with allow_host_loopback: the app reaches the ldapproxy of a
# user domain on the node loopback as 10.0.2.2. Only the web server port is
# published, on the node loopback, for Traefik.

[Unit]
Description=Snipe-IT pod
Requires=snipeit-mariadb.service snipeit-app.service
Before=snipeit-mariadb.service snipeit-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/snipeit.pid %t/snipeit.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/snipeit.pid \
    --pod-id-file %t/snipeit.pod-id \
    --name snipeit \
    --network=slirp4netns:allow_host_loopback=true \
    --publish 127.0.0.1:${TCP_PORT}:80 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/snipeit.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/snipeit.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/snipeit.pod-id
PIDFile=%t/snipeit.pid
Type=forking

[Install]
WantedBy=default.target
