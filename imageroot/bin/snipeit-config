# ExecStartPre of snipeit-app.service: write the container environment
# state/snipeit.env (mode 0600, regenerated at every start, not backed up)
# from the module settings and the cluster smarthost (state/smarthost.env).


import agent
import snipeitconfig

try:
    smarthost = agent.read_envfile("smarthost.env")
except FileNotFoundError:
    smarthost = {}
snipeitconfig.write_env_file("snipeit.env", snipeitconfig.app_env(smarthost))
