#!/bin/bash

#
# Copyright (C) 2026 tebbi
# SPDX-License-Identifier: GPL-3.0-or-later
#

# Runs before the backup, in state/: dump the database. The raw mysql-data
# volume is not backed up (etc/state-include.conf), restore-module loads this
# dump into a new volume (actions/restore-module/40restore_database).

set -e
# the dump holds password hashes and sessions: private to the module user
umask 077

# Never configured: no database to save
if ! systemctl --user -q is-enabled snipeit.service; then
    exit 0
fi
# A configured instance whose database is not running cannot be saved: fail
# the backup instead of storing one without the database (a restore of such
# a backup would start Snipe-IT with an empty database)
if ! systemctl --user -q is-active snipeit-mariadb.service; then
    echo "module-dump-state: snipeit-mariadb.service is not running, the database cannot be saved" >&2
    exit 1
fi

# MYSQL_PWD instead of -p: the password stays off the command line
podman exec snipeit-mariadb /bin/sh -c 'MYSQL_PWD="$MARIADB_PASSWORD" exec mariadb-dump \
        -u "$MARIADB_USER" \
        --default-character-set=utf8mb4 \
        --skip-dump-date \
        --single-transaction \
        --quick \
        --no-tablespaces \
        --add-drop-table \
        "$MARIADB_DATABASE"' > snipeit.sql.tmp
# mariadb-dump ends a complete dump with this line
if ! tail -n 1 snipeit.sql.tmp | grep -q '^-- Dump completed'; then
    rm -f snipeit.sql.tmp
    echo "module-dump-state: the database dump is incomplete" >&2
    exit 1
fi
mv -f snipeit.sql.tmp snipeit.sql
